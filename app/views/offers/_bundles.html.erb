<section id="offres-combinees" class="border-t border-white/5 px-4 py-18 lg:py-24">
  <div class="mx-auto max-w-7xl">
    <div class="mb-14">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-pink-300">03. Offres combinees</p>
      <h2 class="max-w-3xl text-3xl font-extrabold tracking-tight md:text-5xl">
        Site web + Community Management
      </h2>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-gray-400">
        Les clients qui combinent les deux obtiennent une communication plus coherente,
        plus visible et plus simple a piloter.
      </p>
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
      <% catalog.bundles.each do |bundle| %>
        <article class="relative overflow-hidden rounded-[1.75rem] border border-white/10 bg-[#0b0d14] p-7 shadow-2xl shadow-black/20">
          <div class="absolute right-[-3rem] top-[-3rem] h-32 w-32 rounded-full bg-orange-500/15 blur-3xl"></div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-orange-300"><%= bundle.title %></p>
          <h3 class="mt-4 text-2xl font-extrabold tracking-tight text-white"><%= bundle.description %></h3>
          <div class="mt-6 flex items-end gap-3">
            <p class="text-4xl font-extrabold tracking-tight text-orange-300"><%= bundle.discounted_price %></p>
            <p class="pb-1 text-sm text-gray-500 line-through"><%= bundle.original_price %></p>
          </div>
          <p class="mt-4 leading-relaxed text-gray-400"><%= bundle.details %></p>
          <p class="mt-4 text-xs font-semibold uppercase tracking-[0.14em] text-gray-500">Sans engagement</p>
          <%= link_to "Demander ce combo",
                      landing_section_path("contact"),
                      class: "mt-8 inline-flex rounded-full bg-white px-5 py-3 text-sm font-bold text-black transition hover:bg-orange-100" %>
        </article>
      <% end %>
    </div>

    <div class="mt-8 rounded-[1.75rem] border border-indigo-400/20 bg-indigo-500/10 p-6">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-300">Pourquoi combiner ?</p>
      <p class="mt-3 max-w-4xl leading-relaxed text-indigo-50/90">
        <%= catalog.bundles_note %>
      </p>
    </div>
  </div>
</section>
