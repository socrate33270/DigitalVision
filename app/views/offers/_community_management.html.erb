<section id="community-management" class="px-4 py-18 lg:py-24">
  <div class="mx-auto max-w-7xl">
    <div class="mb-14">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-indigo-300">01. Community Management</p>
      <h2 class="max-w-3xl text-3xl font-extrabold tracking-tight md:text-5xl">
        Gestion des reseaux sociaux
      </h2>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-gray-400">
        Facebook, Instagram ou LinkedIn. Une strategie de contenu personnalisee,
        adaptee a chaque reseau et a votre audience.
      </p>
    </div>

    <div class="grid gap-6 xl:grid-cols-3">
      <% catalog.community_management_plans.each do |plan| %>
        <%= render "offers/plan_card", plan: %>
      <% end %>
    </div>

    <div class="mt-8 rounded-[1.75rem] border border-orange-400/20 bg-orange-500/10 p-6">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-orange-300">Creation des visuels</p>
      <p class="mt-3 max-w-4xl leading-relaxed text-orange-50/90">
        <%= catalog.community_management_note %>
      </p>
    </div>
  </div>
</section>
