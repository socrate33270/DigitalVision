<section class="sticky top-20 z-40 px-4 pb-6">
  <div class="mx-auto max-w-7xl">
    <div class="glass overflow-x-auto rounded-full border border-white/10 px-3 py-3">
      <div class="flex min-w-max items-center gap-3">
        <% catalog.navigation_items.each do |item| %>
          <%= link_to "##{item[:anchor]}",
                      class: "rounded-full border border-white/10 px-4 py-2 text-sm font-semibold text-gray-200 transition hover:border-indigo-400/50 hover:bg-white/5 hover:text-white" do %>
            <%= item[:label] %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</section>
