<section class="relative px-4 pt-32 pb-18 lg:pt-44 lg:pb-24">
  <div class="mx-auto max-w-7xl">
    <p class="mb-5 text-sm font-semibold uppercase tracking-[0.22em] text-indigo-300">Grille tarifaire 2025</p>
    <h1 class="max-w-4xl text-5xl font-extrabold leading-tight tracking-tight md:text-7xl">
      Nos offres
      <span class="gradient-text block">& packs</span>
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-gray-400 md:text-xl">
      Trois gammes complementaires pour structurer votre presence digitale : community management,
      creation de sites et offres combinees.
    </p>

    <div class="mt-10 flex flex-col gap-4 sm:flex-row">
      <%= link_to "Parler de votre projet",
                  landing_section_path("contact"),
                  class: "rounded-lg bg-white px-8 py-4 text-lg font-bold text-black transition hover:bg-gray-200" %>
      <%= link_to "Revenir a la vitrine",
                  root_path,
                  class: "glass rounded-lg px-8 py-4 text-lg font-bold text-white transition hover:bg-white/10" %>
    </div>
  </div>
